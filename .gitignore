.env
node_modules/
.DS_Store
*.csv
*.pdf
.superpowers/
.next/
.vercel
.env*.local

# Supabase CLI scratch state — regenerated by `supabase link`
supabase/.temp/

# Claude Code local settings — previously only hidden by a machine-global
# excludes rule, so it showed up as untracked on any other machine
.claude/

# Build artifacts (already covered inside web/.gitignore; hoisted for anything
# compiled outside web/)
*.tsbuildinfo
*.log
coverage/

# Claude Code session transcripts exported to the working tree, e.g.
# 2026-07-31-150137-lost-boys-demolition-ops-system-read-claudemd.txt
# These are hundreds of KB of scrollback and must never be committed. The
# date+time prefix keeps this from touching the tracked prompt .txt files in
# docs/archive/, which carry no such prefix.
20??-??-??-??????-*.txt
